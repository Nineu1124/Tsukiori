{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nineu1124/Tsukiori/contracts/runtime-adapter-contract.v1.schema.json",
  "title": "Tsukiori Runtime Adapter Evidence Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtime",
    "evidence",
    "boundaries",
    "capabilities",
    "unknowns",
    "knownIssues"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "protocol", "recommendedScope"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string", "minLength": 1 },
        "recommendedScope": {
          "enum": ["global", "project", "worktree", "session"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityMatrix", "capabilityMatrixSha256", "report"],
      "properties": {
        "capabilityMatrix": { "type": "string", "minLength": 1 },
        "capabilityMatrixSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "report": { "type": "string", "minLength": 1 }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlChannel",
        "eventChannel",
        "oneReaderPerHandle",
        "runtimeScopeEvents",
        "connectionEpoch",
        "eventReplay"
      ],
      "properties": {
        "controlChannel": { "type": "string", "minLength": 1 },
        "eventChannel": { "type": "string", "minLength": 1 },
        "oneReaderPerHandle": { "const": true },
        "runtimeScopeEvents": { "$ref": "#/$defs/capability" },
        "connectionEpoch": { "$ref": "#/$defs/capability" },
        "eventReplay": { "$ref": "#/$defs/capability" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "knownIssues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "supportLevel": {
      "enum": ["supported", "experimental", "degraded", "unsupported", "unknown"]
    },
    "enforcementLevel": {
      "enum": [
        "runtime_sandbox",
        "os_sandbox",
        "interceptable",
        "observable_only",
        "opaque",
        "unknown"
      ]
    },
    "commitment": {
      "enum": ["stage0_evidence", "not_committed"]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "supportLevel",
        "enforcementLevel",
        "commitment",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "supportLevel": { "$ref": "#/$defs/supportLevel" },
        "enforcementLevel": { "$ref": "#/$defs/enforcementLevel" },
        "commitment": { "$ref": "#/$defs/commitment" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
