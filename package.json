{
  "name": "tsukiori",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first multi-agent desktop workspace",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run check:checkpoints && npm run check:secrets",
    "check:checkpoints": "node scripts/verify-checkpoints.mjs",
    "check:secrets": "node scripts/secret-scan.mjs",
    "test:contract": "node --test spikes/adapter-contract/*.test.mjs",
    "test:gate0": "node --test tests/gates/g0.test.mjs",
    "test:gate1": "pnpm run build && node --test tests/gates/g1.test.mjs",
    "test:gate2": "pnpm run build && node --test tests/gates/g2.test.mjs",
    "test:gate3": "pnpm run build && node --test tests/gates/g3.test.mjs",
    "test:gate4": "pnpm run build && node --test tests/gates/g4.test.mjs",
    "test:codex": "node --test spikes/codex/*.test.mjs",
    "test:codex-adapter": "pnpm run build && node --test tests/codex-adapter/*.test.mjs",
    "spike:codex": "node spikes/codex/harness.mjs",
    "probe:codex-adapter": "pnpm run build && node scripts/probe-codex-adapter.mjs",
    "test:windows": "node --test spikes/windows/*.test.mjs",
    "spike:windows": "node spikes/windows/harness.mjs",
    "test:opencode": "node --test spikes/opencode/*.test.mjs",
    "test:opencode-adapter": "pnpm run build && node --test tests/opencode-adapter/*.test.mjs",
    "test:alpha": "pnpm run build && node --test tests/alpha-workflow/*.test.mjs",
    "test:dual-runtime": "pnpm run build && node --test tests/dual-runtime/*.test.mjs",
    "probe:opencode-adapter": "pnpm run build && node scripts/probe-opencode-adapter.mjs",
    "probe:gate3": "pnpm run build && node scripts/probe-gate3-real.mjs",
    "spike:opencode": "node spikes/opencode/harness.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test:host": "pnpm run build && node --test tests/host/*.test.mjs",
    "test:ipc": "pnpm run build && node --test tests/ipc/*.test.mjs",
    "test:database": "pnpm run build && node --test tests/database/*.test.mjs",
    "test:runtime": "pnpm run build && node --test tests/runtime/*.test.mjs",
    "test:permission": "pnpm run build && node --test tests/permission/*.test.mjs",
    "test:ui": "node --test tests/ui/*.test.mjs",
    "test:project": "pnpm run build && node --test tests/project/*.test.mjs",
    "test:worktree": "pnpm run build && node --test tests/worktree/*.test.mjs",
    "test:workspace": "pnpm run build && node --test tests/workspace/*.test.mjs",
    "test:git": "pnpm run build && node --test tests/git/*.test.mjs",
    "test:recovery": "pnpm run build && node --test tests/recovery/*.test.mjs",
    "test:security": "pnpm run build && node --test tests/security/*.test.mjs",
    "test:observability": "pnpm run build && node --test tests/observability/*.test.mjs",
    "test:release": "pnpm run build && node --test tests/release/*.test.mjs"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "1.18.4",
    "@types/node": "26.1.2",
    "node-pty": "1.1.0",
    "turbo": "2.10.8",
    "typescript": "7.0.2"
  }
}
